# These are all publishable/public keys by design (Supabase publishable key,
# Stripe publishable key) — safe to commit. This file exists specifically so
# that Vite picks them up during `vite build` regardless of which git branch
# is being built, sidestepping a documented Cloudflare Workers Builds bug
# where dashboard-configured "Variables and secrets" only apply to the
# Production branch trigger and are invisible/unset for Preview branch builds.
VITE_SUPABASE_URL=https://wmnueemuldnhwzukckyi.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_PippdEzKrvMHawqqoWmluQ_5io2T5LO
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51U4OGzCtU40ulv8My0w4J8LcpGdPfrDtEBC7HsLtXjrPzaGa6jbT5Ov9Qc5andjXjURaLp4CmJUo5n0510V49ebr00p8NkQHw0
